# Ubuntu server deployment. When MATCH_DB_USER=root, both password values must match.
MATCH_FRONTEND_PORT=19140
MATCH_BACKEND_PORT=19141
MATCH_DB_PORT=3307
MATCH_DB_NAME=match
MATCH_DB_USER=root
MATCH_DB_PASSWORD=replace-with-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-strong-database-password
MATCH_PARTICIPANT_LOGIN_GATE_ENABLED=true
MATCH_ALLOWED_ORIGINS=http://your-server-ip:19140
