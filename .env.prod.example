# Ubuntu server deployment. When MATCH_DB_USER=root, both password values must match.
MATCH_FRONTEND_PORT=19140
XKP_AGENT_PORT=19443
XKP_AGENT_TLS_DIR=/etc/xkp/agent-tls
MATCH_BACKEND_PORT=19141
MATCH_DB_PORT=3307
MATCH_DB_NAME=match
MATCH_DB_USER=root
MATCH_DB_PASSWORD=replace-with-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-strong-database-password
MATCH_PARTICIPANT_LOGIN_GATE_ENABLED=true
MATCH_ALLOWED_ORIGINS=http://your-server-ip:19140
# Externally reachable Agent WebSocket endpoint; production requires WSS and rejects loopback.
TERMINAL_AGENT_RELAY_URL=wss://your-server-host:19443/terminal/v1/agent
# Comma-separated keyId=base64X509PublicKey entries. Public keys only.
XKP_LICENSE_PUBLIC_KEYS=production-2026-01=replace-with-base64-x509-ed25519-public-key
# Built-in private Registry. Keep TLS private keys on the server only.
XKP_REGISTRY_IMAGE=registry:2
XKP_REGISTRY_IMPORTER_IMAGE=xkp5/registry-importer:latest
XKP_REGISTRY_TLS_DIR=/etc/xkp/registry-tls
XKP_REGISTRY_CA_FILE=/etc/xkp/registry-tls/ca.crt
XKP_REGISTRY_STAGING_DIR=/var/lib/xkp/registry/staging
XKP_REGISTRY_IMPORT_DIR=/var/lib/xkp/registry/import
XKP_REGISTRY_STAGING_ROOT=/data/registry-staging
XKP_REGISTRY_IMPORT_ROOT=/data/registry-import
XKP_REGISTRY_MAX_FILE_BYTES=21474836480
XKP_REGISTRY_VOLUME_NAME=match-v2_registry_data
