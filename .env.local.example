# Local infrastructure and direct-running backend.
MATCH_FRONTEND_PORT=19140
MATCH_BACKEND_PORT=19141
MATCH_DB_HOST=localhost
MATCH_DB_PORT=3307
MATCH_DB_NAME=match
MATCH_DB_USER=root
MATCH_DB_PASSWORD=replace-with-your-local-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-the-same-local-mysql-password
MATCH_FASTDFS_TRACKER=localhost:22122
MATCH_FASTDFS_HTTP=http://localhost:8888
MATCH_DATASET_ROOT=download/dataset
MATCH_PYTHON_EXECUTABLE=/opt/anaconda3/envs/match-local/bin/python
MATCH_SCORING_SCRIPT=python/evaluation_score.py
MATCH_SCORING_ANNOTATIONS_ROOT=python
MATCH_SCORING_TIMEOUT_SECONDS=30
# Development-only login seed. Never copy these values into production.
MATCH_DEV_ADMIN_USERNAME=admin123
MATCH_DEV_ADMIN_PASSWORD=admin123
# Local Registry defaults; create TLS files under this directory before startup.
XKP_REGISTRY_IMAGE=registry:2
XKP_REGISTRY_IMPORTER_IMAGE=xkp5/registry-importer:latest
XKP_REGISTRY_TLS_DIR=/etc/xkp/registry-tls
XKP_REGISTRY_CA_FILE=/etc/xkp/registry-tls/ca.crt
XKP_REGISTRY_IMPORTER_SECRETS_DIR=/etc/xkp/registry-secrets
XKP_REGISTRY_STAGING_DIR=runtime/registry/staging
XKP_REGISTRY_IMPORT_DIR=runtime/registry/import
XKP_REGISTRY_STAGING_ROOT=/data/registry-staging
XKP_REGISTRY_IMPORT_ROOT=/data/registry-import
XKP_REGISTRY_MAX_FILE_BYTES=21474836480
XKP_REGISTRY_VOLUME_NAME=match-v2_registry_data
