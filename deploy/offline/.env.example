# Copy this file outside the release package, edit it, then pass it to install.sh.
TARGET_SERVER_IP=192.0.2.10
MATCH_FRONTEND_PORT=19140
XKP_AGENT_PORT=19443
XKP_AGENT_TLS_DIR=/etc/xkp/agent-tls
MATCH_BACKEND_PORT=19141
MATCH_DB_PORT=3307
MATCH_DB_NAME=match
MATCH_DB_USER=root
MATCH_DB_PASSWORD=replace-with-app-database-password
MYSQL_ROOT_PASSWORD=replace-with-root-database-password
MATCH_PARTICIPANT_LOGIN_GATE_ENABLED=true
MATCH_ALLOWED_ORIGINS=http://192.0.2.10:19140
# Comma-separated keyId=base64X509PublicKey entries. Public keys only.
XKP_LICENSE_PUBLIC_KEYS=production-2026-01=replace-with-base64-x509-ed25519-public-key
